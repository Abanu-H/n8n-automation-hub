      "parameters": {
        "url": "=https://news.google.com/rss/search?q=site:in.linkedin.com/jobs/view+\"{{ $json.jobTitle }}\"+\"India\"+{{ $json.isRemote ? 'Remote' : '' }}+when:1d&hl=en-IN&gl=IN&ceid=IN:en",
        "options": {}
      },
      "id": "cb97b56a-5fa2-47f3-94e0-14ba521fe3c4",
      "name": "Fetch LinkedIn Jobs RSS (24h)",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1,
      "position": [
        -96,
        -528
      ]
    },
    {
      "parameters": {
        "jsCode": "return $input.all().filter(item => {\n  const title = item.json.title || '';\n  // Only pass through if it explicitly references India or is from in.linkedin.com\n  return title.includes('India') || item.json.link.includes('in.linkedin.com');\n}).map(item => {\n  const rawTitle = item.json.title || '';\n  const parts = rawTitle.split(' - ');\n  \n  return {\n    json: {\n      job_title: parts[0] ? parts[0].replace(/\\s+-\\s+Google News$/, '').trim() : 'N/A',\n      company_name: parts.length > 1 ? parts[1].trim() : 'LinkedIn Search',\n      url: item.json.link,\n      job_summary: (item.json.contentSnippet || '').replace(/<[^>]*>?/gm, '').trim(),\n      job_posted_date: item.json.pubDate || new Date().toISOString()\n    }\n  };\n});"
      },
      "id": "2cc8cfd4-0fc2-43fa-bea9-4f20d64d4dbb",
      "name": "Format Job Metadata",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        208,
        -528
      ]
    },
    {
      "parameters": {
        "jsCode": "const city = $json[\"City\"] || \"India\";\nconst jobTitle = $json[\"Job Title\"] || \"n8n\";\nconst country = $json[\"Country\"] || \"IN\";\n\nreturn [\n  {\n    json: {\n      input: [\n        {\n          country: country,\n          keyword: jobTitle,\n          location: city,\n          time_range: \"Past week\"\n        }\n      ],\n      custom_output_fields: [\n        \"url\",\n        \"job_title\",\n        \"company_name\",\n        \"job_location\",\n        \"job_summary\",\n        \"job_employment_type\",\n        \"company_url\",\n        \"job_posted_time\",\n        \"discovery_input\",\n        \"apply_link\",\n        \"country_code\",\n        \"job_posted_date\",\n        \"application_availability\"\n      ]\n    }\n  }\n];"
      },
